# 4000, not 3000: the Next.js frontend takes 3000 in dev
PORT=4000
DB_HOST=mongodb+srv://<user>:<password>@<cluster>/cosmogram?retryWrites=true&w=majority

ACCESS_SECRET_KEY=change_me_access_secret
REFRESH_SECRET_KEY=change_me_refresh_secret
# kept short: access tokens are not stored server-side, so this window is
# how long one stays usable after logout
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# OpenCage — birth place autocomplete (GET /api/places). Without it the
# city field silently returns nothing.
GEOCODING_API_KEY=change_me_opencage_key
